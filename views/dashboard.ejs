<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - BeeTrail</title>
    <style>
        /* Basic Reset & Body Styling */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            line-height: 1.6;
            background-color: #f8f9fa; /* Light gray background */
            color: #343a40; /* Darker text color */
            padding: 2rem;
        }

        /* Main Container */
        .container {
            max-width: 1000px;
            margin: 2rem auto;
            background: #ffffff; /* White background for content */
            padding: 2.5rem;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        }

        /* Header Section */
        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #dee2e6; /* Lighter border */
            padding-bottom: 1rem;
            margin-bottom: 2rem;
        }
        .dashboard-header h1 {
            color: #212529; /* Very dark gray/black */
            font-size: 1.8rem;
            font-weight: 600;
        }

        /* Logout Button */
        .logout-button {
            background-color: #dc3545;
            color: white;
            padding: 0.6rem 1.2rem;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            text-decoration: none;
            font-size: 0.95rem;
            transition: background-color 0.2s ease;
        }
        .logout-button:hover {
            background-color: #c82333;
        }

        /* Stats Section */
        .dashboard-stats {
            display: grid;
            /* Responsive grid: 1 col on small, auto-fit on larger */
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem; /* Space between cards */
            margin-bottom: 3rem;
        }
        .stat-card {
            background-color: #eef2f7; /* Lighter, cooler background */
            padding: 1.5rem;
            border-radius: 8px;
            text-align: center;
            border: 1px solid #d6dde5; /* Subtle border */
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .stat-card:hover {
             transform: translateY(-3px);
             box-shadow: 0 6px 12px rgba(0, 0, 0, 0.06);
        }
        .stat-card h2 {
            margin-bottom: 0.75rem;
            font-size: 1.1rem;
            font-weight: 500; /* Slightly less bold */
            color: #495057; /* Medium gray */
        }
        .stat-card .stat-number { /* Changed p to span with class for clarity */
            display: block; /* Make span behave like block */
            font-size: 2.2rem;
            font-weight: 700;
            color: #0d6efd; /* Use a primary color for the number */
        }
         /* Optional: Add icons (using text/emoji here) */
         .stat-card .stat-icon {
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
            color: #6c757d;
         }

        /* Management Links Section */
        .management-links {
            margin-top: 2rem; /* Space above this section */
        }
        .management-links h2 {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 1rem;
            color: #343a40;
             border-bottom: 1px solid #eee;
             padding-bottom: 0.5rem;
        }
        .management-links ul {
            list-style: none; /* Remove default bullets */
            padding: 0;
        }
        .management-links li {
            margin-bottom: 0.75rem; /* Space between links */
        }
        .management-links a {
            display: inline-block; /* Allows padding and looks better */
            color: #0d6efd; /* Link color */
            text-decoration: none;
            padding: 0.5rem 0; /* Vertical padding for better click area */
            transition: color 0.2s ease;
            font-weight: 500;
        }
        .management-links a:hover {
            color: #0a58ca; /* Darker link color on hover */
            text-decoration: underline;
        }

         /* Optional: Style links like buttons */
         /*
         .management-links a.button-link {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            padding: 0.6rem 1rem;
            border-radius: 5px;
            color: #343a40;
            text-decoration: none;
            display: block;  Makes each link take full width
            text-align: center;
            transition: background-color 0.2s ease, border-color 0.2s ease;
         }
         .management-links a.button-link:hover {
             background-color: #e9ecef;
             border-color: #ced4da;
             color: #212529;
             text-decoration: none;
         }
         */

    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <header class="dashboard-header">
            <h1>Admin Dashboard</h1>
            <form action="/admin/logout" method="POST">
                <button type="submit" class="logout-button">Logout</button>
            </form>
        </header>

        <main>
            <!-- Statistics Section -->
            <section class="dashboard-stats">
                <div class="stat-card">
                     <div class="stat-icon">📊</div> <!-- Simple Icon -->
                    <h2>Total Hives</h2>
                    <span class="stat-number"><%= hiveCount %></span>
                </div>
                <div class="stat-card">
                     <div class="stat-icon">🌻</div> <!-- Simple Icon -->
                    <h2>Total Crops</h2>
                    <span class="stat-number"><%= cropCount %></span>
                </div>
                <div class="stat-card">
                     <div class="stat-icon">🧑‍🤝‍🧑</div> <!-- Simple Icon -->
                    <h2>Total Users</h2>
                    <span class="stat-number"><%= userCount %></span>
                </div>
                <!-- Add more stat cards as needed -->
            </section>

            <!-- Management Links Section -->
            <section class="management-links">
                <h2>Management Actions</h2>
                <ul>
                    <li><a href="/api/hives?limit=50" target="_blank">View Recent Hives (API JSON)</a></li>
                    <li><a href="/api/crops/nearby?latitude=0&longitude=0&radius=50000" target="_blank">View Crops (API JSON Example)</a></li>
                    <li><a href="/api/hives/export">Export Hives CSV</a></li>
                    <!-- Add more links here, e.g., <a href="/admin/users">Manage Users</a> -->
                    <!-- Example using button-like styling (uncomment CSS above if using):
                         <li><a href="/api/hives/export" class="button-link">Export Hives CSV</a></li>
                    -->
                </ul>
            </section>
        </main>
    </div>
</body>
</html>